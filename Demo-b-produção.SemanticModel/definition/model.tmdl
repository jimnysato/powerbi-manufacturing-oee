model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

annotation PBI_QueryOrder = ["fApontamentos","fParadas","dCalendario","dMaquina","dProduto","dTurno","dMotivo","CaminhoDados","ApontamentosOrigem","CadastrosOrigem"]

ref table fApontamentos
ref table fParadas
ref table dCalendario
ref table dMaquina
ref table dProduto
ref table dTurno
ref table dMotivo

ref cultureInfo pt-BR

