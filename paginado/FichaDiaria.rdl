<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
<rd:ReportUnitType>Cm</rd:ReportUnitType>
<rd:ReportID>1a542e38-4042-4688-990a-d5498d0dbf9f</rd:ReportID>
<df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
<Description>Ficha diária de produção por injetora (demo B, dados fictícios)</Description>
<Author>Vitor Sato</Author>
<AutoRefresh>0</AutoRefresh>
<DataSources><DataSource Name="ModeloDemoB"><ConnectionProperties><DataProvider>OLEDB-MD</DataProvider>
<ConnectString>Data Source=localhost:57307</ConnectString><IntegratedSecurity>true</IntegratedSecurity></ConnectionProperties>
<rd:SecurityType>Integrated</rd:SecurityType><rd:DataSourceID>6fa206f4-50e4-40a5-a874-55d15623400f</rd:DataSourceID></DataSource></DataSources>
<DataSets><DataSet Name="Ficha"><Query><DataSourceName>ModeloDemoB</DataSourceName>
<CommandText>="DEFINE VAR Dia = TREATAS ( { DATE ( " &amp; Year(Parameters!Data.Value) &amp; ", " &amp; Month(Parameters!Data.Value) &amp; ", " &amp; Day(Parameters!Data.Value) &amp; " ) }, dCalendario[Data] )" &amp; vbCrLf &amp; "EVALUATE" &amp; vbCrLf &amp; "VAR Turnos = CALCULATETABLE (" &amp; vbCrLf &amp; "    ADDCOLUMNS (" &amp; vbCrLf &amp; "        SUMMARIZE ( fApontamentos, dMaquina[Máquina], dMaquina[Tonelagem], dTurno[Turno], dTurno[Nome] )," &amp; vbCrLf &amp; "        ""@OP"", CALCULATE ( MAX ( fApontamentos[OP] ) )," &amp; vbCrLf &amp; "        ""@Produto"", CALCULATE ( MAXX ( fApontamentos, RELATED ( dProduto[Descrição] ) ) )," &amp; vbCrLf &amp; "        ""@Produzido"", [Produzido], ""@Previsto"", [Previsto], ""@Refugo"", [Refugo]," &amp; vbCrLf &amp; "        ""@MinParado"", [Tempo Parado (min)], ""@OEE"", [OEE], ""@Problemas"", [Apontamentos com Problema]," &amp; vbCrLf &amp; "        ""@EficienciaDia"", CALCULATE ( [Eficiência vs Previsto], REMOVEFILTERS ( dTurno ) )," &amp; vbCrLf &amp; "        ""@RefugoPctDia"", CALCULATE ( [% Refugo], REMOVEFILTERS ( dTurno ) )," &amp; vbCrLf &amp; "        ""@OEEDia"", CALCULATE ( [OEE], REMOVEFILTERS ( dTurno ) )" &amp; vbCrLf &amp; "    ), Dia )" &amp; vbCrLf &amp; "VAR Paradas = CALCULATETABLE (" &amp; vbCrLf &amp; "    ADDCOLUMNS (" &amp; vbCrLf &amp; "        SUMMARIZE ( fParadas, dMaquina[Máquina], dMaquina[Tonelagem], dTurno[Turno], dTurno[Nome], dMotivo[Motivo] )," &amp; vbCrLf &amp; "        ""@Min"", [Min Parada]" &amp; vbCrLf &amp; "    ), Dia )" &amp; vbCrLf &amp; "RETURN UNION (" &amp; vbCrLf &amp; "    SELECTCOLUMNS ( Turnos, ""Tipo"", ""T"", ""Maquina"", dMaquina[Máquina], ""Tonelagem"", dMaquina[Tonelagem]," &amp; vbCrLf &amp; "        ""TurnoCod"", dTurno[Turno], ""Turno"", dTurno[Nome], ""OP"", [@OP], ""Produto"", [@Produto]," &amp; vbCrLf &amp; "        ""Produzido"", [@Produzido], ""Previsto"", [@Previsto], ""Refugo"", [@Refugo], ""MinParado"", [@MinParado]," &amp; vbCrLf &amp; "        ""OEE"", [@OEE], ""Problemas"", [@Problemas], ""EficienciaDia"", [@EficienciaDia]," &amp; vbCrLf &amp; "        ""RefugoPctDia"", [@RefugoPctDia], ""OEEDia"", [@OEEDia], ""Motivo"", BLANK (), ""MinMotivo"", BLANK () )," &amp; vbCrLf &amp; "    SELECTCOLUMNS ( Paradas, ""Tipo"", ""P"", ""Maquina"", dMaquina[Máquina], ""Tonelagem"", dMaquina[Tonelagem]," &amp; vbCrLf &amp; "        ""TurnoCod"", dTurno[Turno], ""Turno"", dTurno[Nome], ""OP"", BLANK (), ""Produto"", BLANK ()," &amp; vbCrLf &amp; "        ""Produzido"", BLANK (), ""Previsto"", BLANK (), ""Refugo"", BLANK (), ""MinParado"", BLANK ()," &amp; vbCrLf &amp; "        ""OEE"", BLANK (), ""Problemas"", BLANK (), ""EficienciaDia"", BLANK ()," &amp; vbCrLf &amp; "        ""RefugoPctDia"", BLANK (), ""OEEDia"", BLANK (), ""Motivo"", dMotivo[Motivo], ""MinMotivo"", [@Min] )" &amp; vbCrLf &amp; ")"</CommandText></Query>
<Fields><Field Name="Tipo"><DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Tipo]" /&gt;</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Maquina"><DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Maquina]" /&gt;</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Tonelagem"><DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Tonelagem]" /&gt;</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="TurnoCod"><DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[TurnoCod]" /&gt;</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Turno"><DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Turno]" /&gt;</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="OP"><DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[OP]" /&gt;</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Produto"><DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Produto]" /&gt;</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Produzido"><DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Produzido]" /&gt;</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="Previsto"><DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Previsto]" /&gt;</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="Refugo"><DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Refugo]" /&gt;</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="MinParado"><DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[MinParado]" /&gt;</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="OEE"><DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[OEE]" /&gt;</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="Problemas"><DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Problemas]" /&gt;</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="EficienciaDia"><DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[EficienciaDia]" /&gt;</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="RefugoPctDia"><DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[RefugoPctDia]" /&gt;</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="OEEDia"><DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[OEEDia]" /&gt;</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="Motivo"><DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Motivo]" /&gt;</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="MinMotivo"><DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[MinMotivo]" /&gt;</DataField><rd:TypeName>System.Int64</rd:TypeName></Field></Fields></DataSet></DataSets>
<ReportSections><ReportSection><Body><ReportItems><Tablix Name="Lista"><TablixBody><TablixColumns><TablixColumn><Width>18.6cm</Width></TablixColumn></TablixColumns>
<TablixRows><TablixRow><Height>13cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="Maquina"><ReportItems><Textbox Name="tx1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Injetora " &amp; Fields!Maquina.Value &amp; "  ·  " &amp; First(Fields!Tonelagem.Value) &amp; " t"</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#1E3A5F</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Top>0cm</Top><Left>0cm</Left><Height>0.9cm</Height><Width>12cm</Width><Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="tx2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Parameters!Data.Value, "dddd, dd/MM/yyyy")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Normal</FontWeight><Color>#4A6A90</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Top>0cm</Top><Left>12cm</Left><Height>0.9cm</Height><Width>6.6cm</Width><Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Rectangle Name="kpi3"><ReportItems><Textbox Name="tx4"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Produzido (peças)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Normal</FontWeight><Color>#4A6A90</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Top>0.15cm</Top><Left>0.2cm</Left><Height>0.5cm</Height><Width>3.08cm</Width><Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="tx5"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!Produzido.Value)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>15pt</FontSize><FontWeight>Bold</FontWeight><Color>#1E3A5F</Color><Format>#,0</Format></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Top>0.65cm</Top><Left>0.2cm</Left><Height>0.8cm</Height><Width>3.08cm</Width><Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></ReportItems><KeepTogether>true</KeepTogether><Top>1.1cm</Top><Left>0cm</Left><Height>1.6cm</Height><Width>3.48cm</Width><Style><Border><Style>None</Style></Border><BackgroundColor>#F4F6F9</BackgroundColor></Style></Rectangle><Rectangle Name="kpi6"><ReportItems><Textbox Name="tx7"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Previsto (peças)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Normal</FontWeight><Color>#4A6A90</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Top>0.15cm</Top><Left>0.2cm</Left><Height>0.5cm</Height><Width>3.08cm</Width><Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="tx8"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!Previsto.Value)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>15pt</FontSize><FontWeight>Bold</FontWeight><Color>#1E3A5F</Color><Format>#,0</Format></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Top>0.65cm</Top><Left>0.2cm</Left><Height>0.8cm</Height><Width>3.08cm</Width><Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></ReportItems><KeepTogether>true</KeepTogether><Top>1.1cm</Top><Left>3.78cm</Left><Height>1.6cm</Height><Width>3.48cm</Width><Style><Border><Style>None</Style></Border><BackgroundColor>#F4F6F9</BackgroundColor></Style></Rectangle><Rectangle Name="kpi9"><ReportItems><Textbox Name="tx10"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Eficiência vs previsto</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Normal</FontWeight><Color>#4A6A90</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Top>0.15cm</Top><Left>0.2cm</Left><Height>0.5cm</Height><Width>3.08cm</Width><Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="tx11"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Max(Fields!EficienciaDia.Value)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>15pt</FontSize><FontWeight>Bold</FontWeight><Color>#1E3A5F</Color><Format>0.0%</Format></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Top>0.65cm</Top><Left>0.2cm</Left><Height>0.8cm</Height><Width>3.08cm</Width><Style><Border><Styl